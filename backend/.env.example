# Server
DEBUG=true
HOST=127.0.0.1
PORT=8000

# Database
DATABASE_URL=ENV_DATABASE_URL

# Camera
DEFAULT_CAMERA=webcam
CAMERA_RESOLUTION=640,480
FPS_LIMIT=15

# Thresholds
FACE_MATCH_THRESHOLD=0.6
FATIGUE_EAR_THRESHOLD=0.25
FATIGUE_CONSECUTIVE_FRAMES=15
DISTRACTION_HEAD_ANGLE=30
SEATBELT_REQUIRED=true

# Models
MODELS_DIR=./data/models
PPE_MODEL=yolo11n.pt
FACE_MODEL=buffalo_l

# Actuator (future)
ACTUATOR_TYPE=stub
ARDUINO_PORT=ENV_ARDUINO_PORT
