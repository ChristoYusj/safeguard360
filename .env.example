# Server
DEBUG=
HOST=
PORT=

# Database
DATABASE_URL=

# Camera
DEFAULT_CAMERA=
CAMERA_RESOLUTION=
FPS_LIMIT=

# Thresholds
FACE_MATCH_THRESHOLD=
FATIGUE_EAR_THRESHOLD=
FATIGUE_CONSECUTIVE_FRAMES=
DISTRACTION_HEAD_ANGLE=
SEATBELT_REQUIRED=

# Models
# PPE_MODEL accepts either a bare filename (resolved against MODELS_DIR)
# or an absolute/relative path. Recommended dataset:
#   https://universe.roboflow.com/roboflow-100/construction-safety-gsnvb
# Export as YOLOv8 PyTorch (.pt), drop the file into data/models/, and
# set PPE_MODEL to its filename (e.g. construction-safety.pt). The
# detector auto-maps Hardhat/Safety Vest classes and ignores the
# NO-Hardhat / NO-Safety Vest negative classes.
MODELS_DIR=
PPE_MODEL=
FACE_MODEL=

# Actuator
ACTUATOR_TYPE=
ARDUINO_PORT=

# AI Safety Chatbot. Set EITHER GROQ_API_KEY (free tier, recommended)
# OR OPENAI_API_KEY. Groq is used in preference when both are set.
# Leave both empty to disable the assistant — the UI shows a banner.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
CHATBOT_MAX_HISTORY=20
CHATBOT_MAX_TOKENS=600

# CORS / Cookies
CORS_ALLOWED_ORIGINS=
COOKIE_SECURE=

# Auth
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_APPROVAL_SECRET=
BCRYPT_SALT_ROUNDS=
ACCESS_TOKEN_TTL_MINUTES=
REFRESH_TOKEN_TTL_DAYS=
AUTH_MAX_FAILED_LOGIN_ATTEMPTS=
AUTH_MAX_FAILED_IP_ATTEMPTS=
AUTH_FAILED_LOGIN_WINDOW_MINUTES=
AUTH_LOCKOUT_MINUTES=5

# Admin / Email
ADMIN_EMAIL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
FRONTEND_APP_URL=
TOTP_ENCRYPTION_KEY=

# Bootstrap operator
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_ROLE=

# Frontend
VITE_API_BASE_URL=
VITE_WS_BASE_URL=
VITE_DEV_BACKEND_HTTP_ORIGIN=
VITE_DEV_BACKEND_WS_ORIGIN=
VITE_SUPPORT_EMAIL=
