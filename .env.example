# Copy this file to .env at the repo root. Every value below either works as-is
# or is a secret you must generate (see README "Environment").

# Server
DEBUG=false
HOST=127.0.0.1
PORT=8000

# Database. A relative sqlite path resolves against the repo root.
DATABASE_URL=sqlite:///./data/safeguard360.db

# Camera. Capture is unthrottled; FPS_LIMIT paces the browser preview stream.
FPS_LIMIT=30
# `video_file` sources are looked up inside this directory only.
VIDEO_SOURCES_DIR=./data/video
# Optional: restrict `ip_stream` sources to these hosts/IPs (comma-separated).
# Empty allows any host except loopback, link-local and multicast addresses.
CAMERA_STREAM_ALLOWED_HOSTS=

# Models
# PPE_MODEL accepts either a bare filename (resolved against MODELS_DIR)
# or an absolute/relative path. Recommended dataset:
#   https://universe.roboflow.com/roboflow-100/construction-safety-gsnvb
# Export as YOLOv8 PyTorch (.pt), drop the file into data/models/, and set
# PPE_MODEL to its filename. The detector auto-maps Hardhat/Safety Vest
# classes and ignores the NO-Hardhat / NO-Safety Vest negative classes.
# If the file is missing the PPE detector reports itself unavailable; the
# rest of the app still runs. Model files are runtime assets and are not
# committed to GitHub. See data/models/README.md.
MODELS_DIR=./data/models
PPE_MODEL=construction-safety.pt
FACE_MODEL=buffalo_l

# AI Safety Chatbot. Groq is the only supported provider.
# Leave GROQ_API_KEY empty to disable the assistant — the UI shows a banner.
# Model ids on Groq are retired frequently; check https://console.groq.com/docs/models
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
CHATBOT_MAX_HISTORY=20
CHATBOT_MAX_TOKENS=600

# CORS / Cookies
# Leave CORS_ALLOWED_ORIGINS empty when the frontend is served through the Vite
# dev proxy (same origin). Set it to the frontend origin(s), comma-separated,
# only when the browser talks to the backend cross-origin.
CORS_ALLOWED_ORIGINS=
# Set true when the app is served over HTTPS.
COOKIE_SECURE=false
# Reverse proxies allowed to set X-Forwarded-For (IPs or CIDRs, comma-separated).
# Leave empty when clients connect directly; the header is then ignored.
TRUSTED_PROXIES=

# Auth — REQUIRED secrets. Generate each with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_APPROVAL_SECRET=
BCRYPT_SALT_ROUNDS=12
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
AUTH_MAX_FAILED_LOGIN_ATTEMPTS=5
AUTH_MAX_FAILED_IP_ATTEMPTS=5
AUTH_FAILED_LOGIN_WINDOW_MINUTES=15
AUTH_LOCKOUT_MINUTES=5

# Admin / Email
# REQUIRED: the bootstrap admin's email (also receives account-approval mail).
ADMIN_EMAIL=
# Leave MAIL_TRANSPORT empty to auto-select:
# - `resend` when RESEND_API_KEY and RESEND_FROM_EMAIL are configured
# - `local` otherwise (mail is written to MAIL_LOCAL_OUTBOX_DIR as files)
MAIL_TRANSPORT=
MAIL_LOCAL_OUTBOX_DIR=./backend/data/mail
# Dev-only flag. When true, local reset mode can expose the reset URL directly
# in the browser UI on the same machine. Never enable outside local dev.
MAIL_EXPOSE_LOCAL_RESET_LINKS=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# REQUIRED: frontend origin used when building approval and password-reset
# links. The backend never derives it from request headers.
FRONTEND_APP_URL=http://127.0.0.1:5173
# Origin the API is reachable at from a browser. Leave empty when it is the
# same as FRONTEND_APP_URL (dev proxy / same-origin serving).
PUBLIC_API_BASE_URL=
# REQUIRED: key used to encrypt TOTP secrets at rest. Any long random string:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
TOTP_ENCRYPTION_KEY=

# Bootstrap operator (created on first start if no admin exists).
BOOTSTRAP_ADMIN_NAME=System Administrator
# REQUIRED for the first start. Change it after logging in.
BOOTSTRAP_ADMIN_PASSWORD=

# Frontend (Vite). Leave the API/WS bases empty to use the dev proxy; the dev
# proxy targets default to the backend origins below.
VITE_API_BASE_URL=
VITE_WS_BASE_URL=
VITE_DEV_BACKEND_HTTP_ORIGIN=http://127.0.0.1:8000
VITE_DEV_BACKEND_WS_ORIGIN=ws://127.0.0.1:8000
VITE_SUPPORT_EMAIL=
