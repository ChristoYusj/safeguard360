# Server
DEBUG=
HOST=
PORT=

# Database
DATABASE_URL=

# Camera
CAMERA_RESOLUTION=
FPS_LIMIT=

# Models
# PPE_MODEL accepts either a bare filename (resolved against MODELS_DIR)
# or an absolute/relative path. Recommended dataset:
#   https://universe.roboflow.com/roboflow-100/construction-safety-gsnvb
# Export as YOLOv8 PyTorch (.pt), drop the file into data/models/, and
# set PPE_MODEL to its filename (e.g. construction-safety.pt). The
# detector auto-maps Hardhat/Safety Vest classes and ignores the
# NO-Hardhat / NO-Safety Vest negative classes.
# These model files are runtime assets and are intentionally not committed to
# GitHub. See data/models/README.md for the expected local folder structure.
MODELS_DIR=
PPE_MODEL=
FACE_MODEL=

# AI Safety Chatbot. Groq is the only supported provider.
# Leave GROQ_API_KEY empty to disable the assistant — the UI shows a banner.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
CHATBOT_MAX_HISTORY=20
CHATBOT_MAX_TOKENS=600

# CORS / Cookies
CORS_ALLOWED_ORIGINS=
COOKIE_SECURE=

# Auth
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_APPROVAL_SECRET=
BCRYPT_SALT_ROUNDS=
ACCESS_TOKEN_TTL_MINUTES=
REFRESH_TOKEN_TTL_DAYS=
AUTH_MAX_FAILED_LOGIN_ATTEMPTS=
AUTH_MAX_FAILED_IP_ATTEMPTS=
AUTH_FAILED_LOGIN_WINDOW_MINUTES=
AUTH_LOCKOUT_MINUTES=5

# Admin / Email
ADMIN_EMAIL=
# Leave MAIL_TRANSPORT empty to auto-select:
# - `resend` when RESEND_API_KEY and RESEND_FROM_EMAIL are configured
# - `local` otherwise
MAIL_TRANSPORT=
# Used only when MAIL_TRANSPORT=local
MAIL_LOCAL_OUTBOX_DIR=./backend/data/mail
# Dev-only flag. When true, local reset mode can expose the reset URL directly
# in the browser UI on the same machine.
MAIL_EXPOSE_LOCAL_RESET_LINKS=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Frontend origin used when building approval and password-reset links.
FRONTEND_APP_URL=
TOTP_ENCRYPTION_KEY=

# Bootstrap operator
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Frontend
VITE_API_BASE_URL=
VITE_WS_BASE_URL=
VITE_DEV_BACKEND_HTTP_ORIGIN=
VITE_DEV_BACKEND_WS_ORIGIN=
VITE_SUPPORT_EMAIL=
